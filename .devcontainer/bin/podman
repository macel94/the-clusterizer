#!/usr/bin/env bash

set -euo pipefail

if [[ "$(id -u)" -eq 0 ]]; then
    exec /usr/bin/podman "$@"
fi

exec sudo \
    --preserve-env=ALL_PROXY,COMPOSE_FILE,COMPOSE_PATH_SEPARATOR,COMPOSE_PROFILES,COMPOSE_PROJECT_NAME,CONTAINER_HOST,DATABASE_URL,DOCKER_DEFAULT_PLATFORM,DOCKER_HOST,HTTPS_PROXY,HTTP_PROXY,NO_PROXY,OLLAMA_EMBED_DIM,OLLAMA_EMBED_MODEL,OLLAMA_LLM_MODEL,OLLAMA_URL,TEST_DATABASE_URL,VITE_API_BASE \
    /usr/bin/podman "$@"