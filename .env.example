# Copy this file to .env and fill in the values
DATABASE_URL=postgresql://clusterizer:clusterizer@localhost:5432/clusterizer

# Ollama — local AI backend
OLLAMA_URL=http://localhost:11434

# Embedding model served by Ollama.
# Default: EmbeddingGemma, which is tuned for retrieval, semantic similarity,
# and clustering tasks.
OLLAMA_EMBED_MODEL=embeddinggemma
OLLAMA_EMBED_DIM=768

# LLM used to generate cluster labels.
# Default: explicit Gemma 4 edge 4B tag. You can also use `gemma4` if you want
# Ollama's current latest Gemma 4 tag instead.
OLLAMA_LLM_MODEL=gemma4:e4b

# Optional: only needed when you intentionally run the full real-Jira test stack
# to completion via `docker compose -f docker-compose.test.yml up`.
# Jira requires a valid Jira Software Data Center evaluation/developer license to
# move past the setup wizard's license screen. Leave this unset for normal local
# development, standard backend/frontend tests, or when smoke-testing only up to
# the license step with `JIRA_SETUP_STOP_AFTER=license`.
# JIRA_LICENSE=
# JIRA_SETUP_STOP_AFTER=license
